# OpenRouter API key (required) - get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# Model served via OpenRouter (must support tool/function calling)
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: override the OpenRouter endpoint
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: identify your app to OpenRouter (shows up on their site)
# HTTP_REFERER=https://example.com
# APP_TITLE=Digital Health Canada News Agent

# Optional: Tavily search key - REQUIRED for --mode radar; otherwise web_search prefers Tavily over DuckDuckGo
# Get a key at https://app.tavily.com
TAVILY_API_KEY=tvly-xxxxxxxx

# Where downloads, findings, and the report are written
# DHC_OUTPUT_DIR=output
